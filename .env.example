# FIT HUB Environment Configuration
# ==========================================

# Supabase Project Configuration
# Retrieve these from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-Side Only Service Role (Optional for backend administration, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Port (Default is 3000 in AI Studio)
PORT=3000

# Google Gemini API Key for Server-Side AI Fitness Coach
GEMINI_API_KEY=your-gemini-api-key
